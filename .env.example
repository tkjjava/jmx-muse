# muse-bridge 配置示例
# 复制为 .env 后填写，或用环境变量直接设置。
# 注意：本项目不读取 .env 文件，这些只是给你的配置参考。

# ---- 必填 ------------------------------------------------------------

# 账号库加密密钥。缺失会直接报错。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MUSE_BRIDGE_KEY=

# ---- 存储 ------------------------------------------------------------

MUSE_BRIDGE_DB=./data/muse.db

# ---- 服务 ------------------------------------------------------------

MUSE_BRIDGE_HOST=127.0.0.1
MUSE_BRIDGE_PORT=8788

# 客户端密钥（/v1/*），逗号分隔。留空则不校验（仅限本地使用）
# MUSE_BRIDGE_API_KEYS=sk-my-key-1
MUSE_BRIDGE_API_KEYS=

# 管理密钥（/admin/*），逗号分隔。设了就只认这把：普通调用 key 进不了 /admin。
# 建议生产环境配置；不设则退回认 MUSE_BRIDGE_API_KEYS（/healthz 的
# admin_key_separated 会标 false，如实反映权限面未分离）。
# MUSE_BRIDGE_ADMIN_KEYS=admin-key-1
MUSE_BRIDGE_ADMIN_KEYS=

# 对外地址（反代/公网部署用）。设了之后任务与同步响应里的媒体 url 变成
# https://<这里>/v1/media/{token}；留空保持相对路径。
# MUSE_PUBLIC_BASE=https://api.example.com
MUSE_PUBLIC_BASE=


# ---- 账号调度 --------------------------------------------------------
# legacy：既有轮转（默认）；shadow：仍轮转，只比较评分首选并计数；
# score：TopK 加权随机选号，使用进程内错误率/首输出延迟 EWMA。
# 点名账号始终绕过评分。shadow 不增加上游请求；未知值退回 legacy。
# 健康样品闲置 30 分钟过期，最多保留 1024 个账号/能力组合；重启清空。
# 聊天与生成分开统计，慢视频不会拖低聊天账号评分。
MUSE_SCHEDULER=legacy
# 单次派单最多尝试几个不同的空闲账号。0=不设限（保持既有行为）；1..128。
# 忙号/重复号不计；单账号协议失败后的浏览器回退仍算同一次账号尝试。
# 非整数/负数退回 0；超过 128 截到 128。只限制尝试次数，不限制单次网络耗时。
MUSE_DISPATCH_MAX_ATTEMPTS=0

# ---- 浏览器 ----------------------------------------------------------

# Chrome 调试端点。必须与 --remote-debugging-port 一致
MUSE_CDP_URL=http://127.0.0.1:9222

# 是否无头。默认有头——无头浏览器指纹不同，更容易被上游拒绝
MUSE_HEADLESS=false

# muse.ai 站点地址
MUSE_SITE=https://muse.ai

# ---- 生成行为 --------------------------------------------------------

# 判定"回答结束"的静默窗口（毫秒）
# 调小更灵敏但可能提前截断；调大更保守但收尾更慢
MUSE_QUIET_MS=600

# 等回复超时（秒）
MUSE_REPLY_TIMEOUT=180

# ---- 思考过程透传（默认关闭）--------------------------------------------
# 打开后：若页面确实把思考渲染成独立容器，桥会以 delta.reasoning_content 单独发给
# 客户端，正文仍走 delta.content。关闭时思考容器根本不被查询，输出与没有此功能时
# 逐字节一致。只有流式会带思考；非流式仍只返回正文。relay 按字节透传该字段。
#
# 这是**猜测的常见形态，不是对 muse 真实 DOM 的确认**：内置候选命中即用，命中不到
# 就当没有思考。落地办法是在自己页面的 devtools 里找到思考块，把它的内容容器选择器
# 填到 MUSE_REASONING_SELECTORS，无需改代码。
#
# 两个注意点：
#   * 尽量指向*内容容器*而不是可折叠外壳——外壳的 inner_text 会把"Thinking/思考"
#     标题一起读进来；
#   * 驱动不做去重。命中节点必须与正文容器相互独立，否则同一段文字会既出现在正文
#     又出现在思考字段里。
MUSE_REASONING=0
# 思考容器选择器候选（逗号分隔）。留空=只用内置候选。
MUSE_REASONING_SELECTORS=

# ---- 纯协议驱动（0.4.1，默认关闭）----------------------------------------
# 打开后聊天与生成都走 Noise 协议（不经 CDP/浏览器）。协议失败时回退一次浏览器，
# 回退原因写进派单 note 与 `counters.protocol_fallback`，并落一行 WARNING 日志。
# 聊天与生成的协议路径都已在活网验收通过（2026-11-11，见 CHANGELOG 的
# 「P1-B3~B5 技术欠账清理」与 docs/2026-11-11-roadmap.md）。
# 前提：账号已导入 cookie（POST /admin/accounts/{a}/cookies），且本机能连到
# *.metaaivm.com —— 真机 2026-11-11 实测直连被墙，需要本机代理
# （见 docs/LIVE_RUNBOOK.md，只给 muse.ai / metaaivm.com 走代理）。
MUSE_PROTOCOL_DRIVER=0
# 协议链路的 HTTP/WS 代理地址（给 httpx/websockets 用）。留空=直连（多数网络下会失败）。
#
# 取值原则：**填本机当前真正可用的那个**，不要照抄某个端口号。
# 2026-11-11 实测记录（同一台机器、同一时段）：
#   * `http://127.0.0.1:18000`（mihomo）：`muse.ai` 与 `/api/session` 均为
#     `SSL: UNEXPECTED_EOF_WHILE_READING`——上游节点全挂时的表现。
#   * `http://127.0.0.1:7890`（FlClash）：`/api/session` 200、`hatch/token` 200、
#     WS 升级 101，可正常握手。
# 之前的默认值写的是 18000，照抄会直接连不上，故改为 7890 并留下上面这段依据。
# 换了代理软件就同步改这里，并用 `python tools/acceptance.py stream` 复核。
#
# 注意代理**两条面**可能不一致：会话面（/api/session）与 WS 面（hatch）的可达性
# 未必相同，所以下面还留了 MUSE_SESSION_PROXY 单独指定。
MUSE_PROTOCOL_PROXY=http://127.0.0.1:7890

# 会话面（/api/session、/api/hatch/token）单独的代理。留空则回落到
# MUSE_PROTOCOL_PROXY。2026-11-11 实测直连 /api/session 被墙，必须经代理。
MUSE_SESSION_PROXY=

# ---- 订阅流与暖池（协议模式下的两个预算）----------------------------------
# 连续这么多秒没有任何新字节就结束本回合，避免僵死订阅空转到总 deadline。
# 0 = 关闭该保护（代码默认）。
MUSE_STREAM_IDLE_TIMEOUT=0

# 暖池：跨派单复用同一条 Noise 会话，省掉每回合约 3.3 s 的 WS 升级 + Noise XX 握手。
# 0 = 逐回合新建（代码默认）。
MUSE_WARM_POOL=0
MUSE_WARM_POOL_TTL=300

# ---- 媒体成品清理 ---------------------------------------------------------
# 成品保留时长与清扫间隔。清扫任务由 lifespan 起，只删 token 形态文件与 .part 残留。
MUSE_MEDIA_TTL=172800
MUSE_MEDIA_SWEEP_INTERVAL=3600

# 成品存放目录。留空 = ./data/media（相对工作目录）。
# 与 MUSE_MEDIA_TTL 配套：清扫只管这个目录，换目录等于换一套存储。
MUSE_MEDIA_DIR=./data/media

# 单个成品上限（字节），默认 256 MiB。超限直接拒写，不留半截文件——
# 10 秒视频可到几十 MiB，调小会开始拒收正常的视频成品。
MUSE_MAX_MEDIA_BYTES=268435456

# ---- 生成管线（0.4.0 新增）------------------------------------------------
# 生成能力总开关。关掉时 /v1/images*、/v1/videos* 直接 503，聊天路径不受影响。
MUSE_GENERATION_ENABLED=1

# 三个预算是**分开的**，不要当成一个总超时：
#   MUSE_QUEUE_WAIT_SECONDS 只管"抢账号锁等多久"（排队满了先失败，别无限等）；
#   MUSE_IMAGE_TIMEOUT / MUSE_VIDEO_TIMEOUT 只管"拿到锁之后生成等多久"。
# 上游把两者共用一个 timeout（最坏 2×timeout 才失败），这里刻意拆开互不挤占。
MUSE_QUEUE_WAIT_SECONDS=300
MUSE_IMAGE_TIMEOUT=240
MUSE_VIDEO_TIMEOUT=600

# 同时进行的生成任务数上限。上游是单账号串行，这里调大只是让多个账号并行。
MUSE_GENERATION_CONCURRENCY=2

# 生成任务结果在内存/库里保留多久（秒），默认 2 小时。过期后 /admin/tasks 查不到。
MUSE_TASK_TTL=7200

# ---- 生成任务队列预算 -----------------------------------------------------
# 排队多久算超时（默认 5 分钟）。比一次生成本身短——排到这个量级说明账号池已饱和。
MUSE_JOB_QUEUE_TTL=300
# processing 失联判定：超过这么久没有任何更新就按 interrupted 判失败（进程重启/被杀）。
MUSE_JOB_STALE=900
# 终态行保留时长（默认 1 天），客户端已拿到结果或失败已记账，之后即可清理。
MUSE_JOB_ROW_TTL=86400
# 排队上限。队列满直接 429（与上游同款阈值），没有这层排队会变成无限内存 + 无限等待。
MUSE_JOB_QUEUE_MAX=8

# ---- 参考素材（refs）------------------------------------------------------
# 请求里最多带几个参考素材。注意这里是**入参层面的上限**，超过会被截断。
MUSE_REFERENCE_MAX=10
# 见下一条：refs 层还有一套同名语义的硬上限，两者默认都是 10，但行为不同（一个截断、
# 一个报 400）。要改就两个一起改，只改一个会让实际生效值看起来没变化。
MUSE_MAX_REFERENCE_FILES=10
# 单个素材字节上限（40 MiB）与单次请求素材总字节上限（100 MiB）。
MUSE_MAX_REFERENCE_BYTES=41943040
MUSE_MAX_REFERENCE_TOTAL_BYTES=104857600
# 参考视频最长秒数（默认 120）。超长视频先被拒，避免把整段视频读进内存。
MUSE_MAX_REFERENCE_VIDEO_SECONDS=120

# 取素材的超时（秒）与最多跟随几次重定向。
MUSE_REF_FETCH_TIMEOUT=20
MUSE_REF_MAX_REDIRECTS=10

# 两个**默认关闭**的安全开关，除非明确知道在做什么否则别开：
#   MUSE_REF_LOCAL_FILES=1   允许素材字段读服务器本地文件——等于把任意文件读挂到 API 上；
#   MUSE_REF_PRIVATE_FETCH=1 允许抓内网地址——等于给 API 一个 SSRF 原语。
MUSE_REF_LOCAL_FILES=0
MUSE_REF_PRIVATE_FETCH=0

# ---- 浏览器驱动的超时与冷却 -----------------------------------------------
# "还没出现新气泡"就判没发出去的等待（秒），默认 45。原先要空转满整个回复超时才报错，
# 把责任推给模型；页面上连新气泡都没有，本来就是没发出去。
MUSE_FIRST_REACTION_SECONDS=45

# 瞬时故障冷却（秒）：限流/浏览器暂时拿不到时，冷却期满自动回池。
# 没有这层，一次慢回复就把账号从池子永久摘掉，只能人工 refresh 复活。
MUSE_BRIDGE_RETRY_COOLDOWN=60

# 会话面（/api/session、wake）的两个上游取值，默认沿用上游的 12 s / 8 s。
MUSE_SESSION_TIMEOUT=12
MUSE_WAKE_TIMEOUT=8
